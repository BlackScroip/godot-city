extends SceneTree

const Catalog = preload("res://scripts/domain/catalog.gd")
const Profile = preload("res://scripts/domain/profile.gd")
const Systems = preload("res://scripts/domain/systems.gd")
const Combat = preload("res://scripts/domain/combat.gd")
const Projectile = preload("res://scripts/domain/projectile.gd")
var checks = 0
var failures: Array[String] = []
var catalog
var combat_instances: Array = []

func _initialize() -> void:
	_run.call_deferred()

func check(value: bool, message: String) -> void:
	checks += 1
	if not value: failures.append(message)

func _run() -> void:
	catalog = Catalog.new()
	check(catalog.load_all(), "source catalogs load")
	_test_global_crystal_progress()
	_test_entitlements()
	_test_node_transactions()
	_test_work_upgrade_claim()
	_test_imported_nodes()
	_test_imported_behaviors()
	_test_property_context_consumers()
	_test_attack_definition_modifier()
	_test_skill_economy()
	_test_record_entry()
	for actor in combat_instances:
		actor.drain_events()
		actor._pending.clear()
	combat_instances.clear()
	var result = {"checks": checks, "failures": failures, "passed": failures.is_empty(), "scope": "New APK global awakening, entitlements, 120-node dependency closure, transactions and save restore, representative combat effects, native skill charge formulas and context duration/layer consumers on actual character-eight configuration; focused dispatch upgrade-at-claim regression. Does not establish full original APK runtime or visual parity."}
	var report = FileAccess.open("res://reports/new-apk-awakening-tests.json", FileAccess.WRITE)
	if report:
		report.store_string(JSON.stringify(result, "\t"))
		report.close()
	print("NEW_APK_AWAKENING_TEST ", JSON.stringify(result))
	quit(0 if failures.is_empty() else 1)

func _test_global_crystal_progress() -> void:
	var p = Profile.new()
	var s = Systems.new(catalog, p)
	check(s.material(504) == 0 and s.awakening_progress().level == 0, "fresh account has no derived awakening crystals or level")
	s.set_record("chaos:clear:1", 1)
	check(s.material(504) == 0, "unclaimed chaos clear does not mint awakening crystals")
	s.set_record("chaos:claimed:1", 1)
	var progress = s.awakening_progress()
	check(s.material(504) == 25 and progress.level == 0 and progress.progress == 25 and progress.required == 50, "first claimed layer contributes twenty-five toward first fifty-crystal threshold")
	s.set_record("chaos:claimed:2", 1)
	progress = s.awakening_progress()
	check(s.material(504) == 50 and progress.level == 1 and progress.progress == 0, "claims from another character combine into one global awakening level")
	s.set_record("chaos:claimed:1", 5)
	progress = s.awakening_progress()
	check(progress.total == 150 and progress.level == 3 and progress.progress == 0, "level thresholds consume cumulative contributions across characters")
	s.set_record("chaos:claimed:1", 10)
	progress = s.awakening_progress()
	check(progress.total == 300 and progress.level == 5 and progress.progress == 50 and progress.required == 100, "progress rolls into higher hundred-crystal threshold")
	s.set_record("chaos:claimed:2", 15)
	progress = s.awakening_progress()
	check(progress.total == 550 and progress.level == 8 and progress.progress == 0, "chaos layers without crystal rewards add no awakening total")
	var before = JSON.stringify(p.data)
	check(s.upgrade_awakening_level(1).success and JSON.stringify(p.data) == before and s.material(504) == 550, "manual level button cannot consume derived crystals or add an extra level")
	s.grant_material(504, 99999)
	check(s.material(504) == 550 and s.awakening_progress().level == 8, "arbitrary material grant cannot inflate derived awakening progression")
	var restored = Profile.new()
	check(restored.restore(JSON.parse_string(JSON.stringify(p.data))), "global claims and derived material bookkeeping survive save restore")
	var resumed = Systems.new(catalog, restored)
	check(resumed.material(504) == 550 and resumed.awakening_progress().level == 8, "restored account derives the same global crystal total and level")

func _test_entitlements() -> void:
	var p = Profile.new()
	var s = Systems.new(catalog, p)
	s.set_blessing_mode(1)
	check(s.awakening_progress().points == 0, "ordinary blessing selection adds no awakening points")
	s.set_blessing_mode(2)
	check(s.awakening_progress().points == 0, "ultra mode selection without entitlement adds no awakening points")
	s.set_record("entitlement:blessing_plus", 1)
	check(s.awakening_progress().points == 5, "plus entitlement grants five awakening points")
	s.set_record("entitlement:blessing_ultra", 1)
	check(s.awakening_progress().points == 10, "plus and ultra entitlements stack to ten points")
	s.set_record("entitlement:blessing_plus", 2)
	check(s.awakening_progress().points == 10, "repeated entitlement marker does not duplicate its point bonus")
	s.set_record("purchase:2019:never", 1)
	check(s.material(504) == 1000 and s.awakening_progress().level == 11 and s.awakening_progress().points == 21, "product 2019 contributes one thousand crystals through the global threshold schedule")
	s.set_record("purchase:2019:never", 3)
	s.set_record("entitlement:awake_pack", 1)
	check(s.material(504) == 1000, "purchase history and restored entitlement alias count product 2019 once")
	var restored = Profile.new()
	check(restored.restore(JSON.parse_string(JSON.stringify(p.data))), "awakening entitlement flags survive save restore")
	var resumed = Systems.new(catalog, restored)
	check(resumed.material(504) == 1000 and resumed.awakening_progress().points == 21, "restore does not replay entitlement awards")

func _test_node_transactions() -> void:
	var p = Profile.new()
	p.data.buildings["2"] = 1
	var s = Systems.new(catalog, p)
	s.grant_material(101, 200000)
	s.grant_material(503, 100)
	var before = JSON.stringify(p.data)
	check(not s.unlock_awakening(103).success and JSON.stringify(p.data) == before, "funded node stays locked below global awakening level")
	s.set_record("chaos:claimed:1", 2)
	check(s.material(504) == 50 and s.awakening_progress().level == 1, "two claimed layers unlock first awakening tier")
	var gold = s.material(101)
	var cubes = s.material(503)
	check(s.unlock_awakening(103).success and s.material(101) == gold - 10000 and s.material(503) == cubes - 5 and s.material(504) == 50, "node unlock spends only configured gold and cubes")
	before = JSON.stringify(p.data)
	check(not s.unlock_awakening(103).success and JSON.stringify(p.data) == before, "unlocked node cannot charge its unlock price twice")
	check(s.toggle_awakening(103).success and p.data.active_awakenings == [103] and s.material(504) == 50, "activation reserves a point without spending crystals")
	gold = s.material(101)
	cubes = s.material(503)
	check(s.toggle_awakening(103).success and p.data.active_awakenings.is_empty(), "repeated activation toggles off instead of appending a duplicate")
	check(s.toggle_awakening(103).success and p.data.active_awakenings == [103] and s.material(101) == gold and s.material(503) == cubes, "reactivation does not charge unlock materials again")
	s.set_record("chaos:claimed:1", 4)
	check(s.unlock_awakening(102).success, "second-tier node unlock uses cumulative account progression")
	before = JSON.stringify(p.data)
	check(not s.toggle_awakening(102).success and JSON.stringify(p.data) == before, "activation above per-character point capacity is atomic")
	s.set_record("entitlement:blessing_plus", 1)
	check(s.toggle_awakening(102).success and p.data.active_awakenings.size() == 2, "entitlement points expand activation capacity")
	p.data.character_levels["2"] = 1
	check(s.unlock_awakening(201).success and s.toggle_awakening(201).success, "global level and point capacity apply to each owned character")
	var restored = Profile.new()
	check(restored.restore(JSON.parse_string(JSON.stringify(p.data))), "unlocked and active awakening nodes survive save restore")
	var resumed = Systems.new(catalog, restored)
	check(restored.data.active_awakenings.size() == 3 and resumed.stat("awake:unlocked:103") == 1 and resumed.material(504) == 100, "restore preserves node claims and global crystal derivation")
	before = JSON.stringify(restored.data)
	check(not resumed.unlock_awakening(103).success and JSON.stringify(restored.data) == before, "restored node unlock cannot replay material deduction")
	resumed.begin_run(812, 1, 100)
	before = JSON.stringify(restored.data)
	check(not resumed.toggle_awakening(103).success and not resumed.upgrade_awakening_level(1).success and JSON.stringify(restored.data) == before, "adventure cannot change persistent awakening allocation")

func _test_work_upgrade_claim() -> void:
	var p = Profile.new()
	var s = Systems.new(catalog, p)
	var clock = {"now": 100000}
	s.utc_now = func(): return int(clock.now)
	p.data.buildings["6"] = 1
	s.grant_material(101, 5000)
	var gold = s.material(101)
	check(s.start_work(101).success and s.material(101) == gold, "work starts without a monster partner or upfront payment")
	check(s.upgrade_work(101).success and s.material(101) == gold - 500, "active work accepts its configured upgrade cost")
	clock.now += 600
	check(s.work_status(101).claimable_quantity == 1 and s.work_status(101).reward.amount == 1000, "finished cycle sees current upgraded payout")
	gold = s.material(101)
	check(s.collect_work(101).success and s.material(101) == gold + 1000 and s.stat("work:finished") == 1, "upgraded in-flight work pays once at claim")
	gold = s.material(101)
	check(not s.collect_work(101).success and s.material(101) == gold, "work claim cannot replay without another completed cycle")

func _funded_systems():
	var p = Profile.new()
	p.data.buildings["2"] = 1
	var s = Systems.new(catalog, p)
	for id in range(1, 9):
		p.data.character_levels[str(id)] = 1
		s.set_record("chaos:claimed:" + str(id), 10)
	s.grant_material(101, 50000000)
	s.grant_material(503, 10000)
	return s

func _test_imported_nodes() -> void:
	var report = JSON.parse_string(FileAccess.get_file_as_string("res://reports/new-apk-awakening-import.json"))
	var actor = _combat()
	check(catalog.rows("CharaTalentAwakeTreeData").size() == 120, "all one hundred twenty source awakening nodes imported")
	check(catalog.rows("CharaTalentAwakeTreeData").filter(func(row): return int(row.chara_id) == 8).size() == 15, "character eight has all fifteen source awakening nodes")
	for pair in [["ability", "AbilityItems"], ["buff", "Buffs"], ["damage", "DamageValues"]]:
		var missing = report.required[pair[0]].filter(func(id): return catalog.find(pair[1], int(id)).is_empty())
		check(missing.is_empty(), "domain dependency closure resolves " + pair[0] + ": " + str(missing))
	for pair in [["buff", actor._buff_index], ["summon", actor._summon_index], ["damage", actor.catalog.damage_definitions]]:
		var missing = report.required[pair[0]].filter(func(id): return not pair[1].has(str(id)))
		check(missing.is_empty(), "combat dependency closure resolves " + pair[0] + ": " + str(missing))
	var s = _funded_systems()
	for id in report.new_vs_previous_apk_node_ids:
		var row = catalog.find("CharaTalentAwakeTreeData", int(id))
		var before = JSON.stringify(s.profile.data)
		if bool(row.get("is_admin_mode", false)):
			check(not s.unlock_awakening(int(id)).success and JSON.stringify(s.profile.data) == before, "source admin-only node stays locked without charging: " + str(id))
			continue
		check(s.unlock_awakening(int(id)).success and s.toggle_awakening(int(id)).success, "new node unlocks and activates: " + str(id))
		check(s.persistent_ability_ids(int(row.chara_id)).has(int(row.ability_item_id)), "new node contributes its source ability: " + str(id))
		var ability = catalog.find("AbilityItems", int(row.ability_item_id))
		if not str(ability.get("ModifyBuff", "")).is_empty():
			var roots = s.progression_buff_bindings(int(row.chara_id)).roots
			for buff_id in Catalog.ids(ability.ModifyBuff):
				check(roots.any(func(root): return root.id == str(buff_id)), "new node binds actual combat root: " + str(id))
		s.toggle_awakening(int(id))
	check(s.toggle_awakening(813).success and s.toggle_awakening(814).success, "imported character-eight context nodes can be allocated together")
	var restored = Profile.new()
	check(restored.restore(JSON.parse_string(JSON.stringify(s.profile.data))), "imported awakening nodes survive save restore")
	var resumed = Systems.new(catalog, restored)
	check(restored.data.active_awakenings == [813, 814] and resumed.persistent_ability_ids(8).has(260514814), "restore preserves imported active nodes and source ability binding")
	var before = JSON.stringify(restored.data)
	check(not resumed.unlock_awakening(814).success and JSON.stringify(restored.data) == before, "restored imported node cannot charge again")

func _combat(character_id: int = 1):
	var actor = Combat.new()
	actor.configure(null, null, character_id, 0, 5401)
	actor.statuses.clear()
	actor.drain_events()
	combat_instances.append(actor)
	return actor

func _test_imported_behaviors() -> void:
	var actor = _combat(8)
	actor.add_buff("800000")
	actor.add_buff("800100", 15)
	actor.tick(0.11)
	actor.add_buff("840300")
	check(actor.request_attack(4).success and actor.buff_layers("800210") == 3, "node 803 real blade heavy-start grants three actual flurry layers")
	var source = _combat(8)
	var target = _combat()
	source.add_buff("840100")
	target.receive({"source": source, "damage": 10.0, "sequence": 1, "emission": 1, "definition": {"damageId": 2800000, "actType": "NormalAtk"}}, source.attack)
	check(target.buff_layers("800312") == 3, "node 801 normal damage applies three actual sand-mark layers to victim")

func _test_property_context_consumers() -> void:
	var actor = _combat(8)
	actor.add_buff("800210", 100)
	check(actor.buff_layers("800210") == 5, "flurry source stack cap is five without awakening")
	actor.add_buff("841300")
	actor.add_buff("800210", 100)
	check(actor.buff_layers("800210") == 15, "node 813 raises actual flurry stack cap by ten")
	actor.custom_properties["825100_luanwu_maxlayer"] = 4
	actor.add_buff("800210", 100)
	check(actor.buff_layers("800210") == 19, "pipe-separated property contexts sum with the awakening stack cap")
	var caster = _combat()
	var victim = _combat()
	caster.add_buff("141000")
	victim.bind_buff_caster("119901", caster)
	victim.add_buff("119901")
	check(is_equal_approx(float(victim.statuses["119901"].time), 10.1), "burn duration consumes caster awakening context in milliseconds")
	caster.tick(0.1)
	check(float(caster.statuses["141000"].time) < 0, "duration context leaves permanent passive lifetime unchanged")
	var baseline = _combat(8)
	baseline.spawn_summon("800000")
	baseline.tick(0)
	var baseline_hits = baseline.drain_events().filter(func(event): return event.type == "hit" and event.get("summon_id", "") == "800000")
	check(baseline_hits.size() == 1 and is_equal_approx(float(baseline_hits[0].definition.lifetime), 4), "sandstorm source projectile lasts four seconds")
	var upgraded = _combat(8)
	upgraded.add_buff("841400")
	upgraded.spawn_summon("800000")
	upgraded.tick(0)
	var upgraded_hits = upgraded.drain_events().filter(func(event): return event.type == "hit" and event.get("summon_id", "") == "800000")
	check(upgraded_hits.size() == 1 and is_equal_approx(float(upgraded_hits[0].definition.lifetime), 6), "node 814 extends scheduled sandstorm projectile to six seconds")
	if not upgraded_hits.is_empty():
		var projectile = Projectile.new()
		projectile.configure(upgraded_hits[0], Vector3.ZERO, Vector3.FORWARD, Vector3.ZERO)
		check(is_equal_approx(projectile.lifetime, 6), "projectile simulation receives adjusted raw motion lifetime")
		projectile.advance(4.1, Vector3.ZERO, Vector3.FORWARD)
		check(not projectile.finished, "awakened sandstorm remains active beyond original four seconds")
		projectile.advance(2, Vector3.ZERO, Vector3.FORWARD)
		check(projectile.finished, "awakened sandstorm expires at six seconds")
	check(is_equal_approx(float(upgraded._summon_index["800000"].hit.lifetime), 4), "summon duration context does not mutate shared source catalog")

func _test_record_entry() -> void:
	var s = _funded_systems()
	s.unlock_awakening(313)
	s.toggle_awakening(313)
	s.begin_run(5411, 3, 100)
	var before = float(s.attributes(3).get("HpAddFixed", 0))
	check(s.record_node_entry_effects("awakening-room-a", "Battle").success and is_equal_approx(float(s.attributes(3).get("HpAddFixed", 0)), before + 20), "node 313 grants twenty actual max-health attribute per room entry")
	check(not s.record_node_entry_effects("awakening-room-a", "Battle").success and is_equal_approx(float(s.attributes(3).get("HpAddFixed", 0)), before + 20), "room entry retry cannot duplicate awakening health")
	check(s.record_node_entry_effects("awakening-room-b", "Shop").success and is_equal_approx(float(s.attributes(3).get("HpAddFixed", 0)), before + 40), "node 313 applies in different source room types")
	var fighter = _combat()
	var base = fighter.max_health
	fighter.set_external_attributes(s.attributes(3))
	var bindings = s.progression_buff_bindings(3)
	fighter.set_progression_buffs(bindings.roots, bindings.externally_counted_numeric_ids)
	check(is_equal_approx(fighter.max_health, base + before + 40), "node 313 room health reaches actual fighter once through external numerical binding")

func _sandstorm_hit(actor) -> Dictionary:
	actor.spawn_summon("800000")
	actor.tick(0)
	for event in actor.drain_events():
		if event.type == "hit" and event.get("summon_id", "") == "800000": return event
	return {}

func _test_attack_definition_modifier() -> void:
	var plain = _combat(8)
	var normal_hit = _sandstorm_hit(plain)
	var upgraded = _combat(8)
	upgraded.add_buff("840400")
	var hit = _sandstorm_hit(upgraded)
	var normal = Projectile.new()
	normal.configure(normal_hit, Vector3.ZERO, Vector3.FORWARD, Vector3.ZERO)
	var storm = Projectile.new()
	storm.configure(hit, Vector3.ZERO, Vector3.FORWARD, Vector3.ZERO)
	check(is_equal_approx(storm.radius, normal.radius * 1.5), "node 804 increases actual storm collision dimensions by fifty percent")
	check(normal.drain_interval_summons().is_empty(), "unawakened storm does not emit attraction summons")
	var pulses = storm.drain_interval_summons()
	check(pulses.size() == 1 and str(pulses[0].AddSummonUnitId) == "800001", "node 804 creates its source attraction pulse immediately")
	storm.advance(0.41, Vector3.ZERO, Vector3.FORWARD)
	check(storm.drain_interval_summons().size() == 2 and storm.drain_interval_summons().is_empty(), "source attraction repeats every two tenths without replaying a frame")
	var restored = Projectile.new()
	restored.restore(JSON.parse_string(JSON.stringify(storm.snapshot())))
	check(restored.drain_interval_summons().is_empty(), "projectile restore does not replay already emitted attraction pulses")
	storm.advance(0.2, Vector3.ZERO, Vector3.FORWARD)
	restored.advance(0.2, Vector3.ZERO, Vector3.FORWARD)
	check(storm.drain_interval_summons().size() == 1 and restored.drain_interval_summons().size() == 1, "restored attraction timer retains the original pulse schedule")
	var world = DungeonWorld.new()
	var source = DungeonActor.new()
	source.combat = _combat()
	source.position = Vector3(30, 0, 0)
	var victim = DungeonActor.new()
	victim.combat = _combat()
	victim.position = Vector3(3, 0, 0)
	var attraction: Dictionary = upgraded._summon_index["800001"].hit
	world._apply_feedback(source, victim, {"definition": attraction, "impact_origin": [0, 0, 0], "profile": {"category": "light", "distance": 1.0, "travel": 0.2, "stagger": 0.0}})
	check(victim.knockback_direction.dot(Vector3.LEFT) > 0.99, "attraction pulls victim toward storm center independently of caster position")
	# This isolated world never enters the tree to attach its owned presentation nodes.
	for node in [world.ground_loot, world.spirit_followers, world.player_transfer, world.player_revival]: node.free()
	world.free()
	source.free()
	victim.free()
	check(upgraded.diagnostics.filter(func(message): return "840400" in message).is_empty(), "node 804 no longer reports an unimplemented dynamic rule")

func _test_skill_economy() -> void:
	var orb = _combat(6)
	orb.add_buff("618100")
	var before = orb.skill_capacity(2)
	orb.add_buff("641100")
	check(is_equal_approx(orb.skill_capacity(2), before - float(orb.fighter.skills[2].sp)), "node 611 removes exactly one actual combat-skill use")
	var plain = _combat()
	var victim = _combat()
	var damage = victim.receive({"source": plain, "damage": 10.0, "sequence": 1, "emission": 1, "definition": {"damageId": 160001, "actType": "SubActiveSkill"}}, plain.attack)
	var upgraded_victim = _combat()
	var upgraded_damage = upgraded_victim.receive({"source": orb, "damage": 10.0, "sequence": 1, "emission": 1, "definition": {"damageId": 160001, "actType": "SubActiveSkill"}}, orb.attack)
	check(is_equal_approx(upgraded_damage, damage * 2), "node 611 source child doubles actual combat-skill damage")
	var blade = _combat(8)
	var maximum = blade.skill_capacity(2)
	var cost = blade.skill_cost(2)
	blade.add_buff("840900")
	check(is_equal_approx(blade.skill_capacity(2), maximum * 2) and is_equal_approx(blade.skill_cost(2), cost * 2), "node 809 doubles actual combat-skill charge capacity and consumption")
	blade.energy[2] = cost
	check(blade.input_block_reason(2) == "Insufficient energy" and not blade.request_attack(2).success, "old charge amount cannot bypass awakened skill cost")
	blade.energy[2] = blade.skill_capacity(2)
	check(blade.request_attack(2).success and is_zero_approx(float(blade.energy[2])), "awakened cast consumes modified skill charge")
	var recharged = _combat(8)
	recharged.add_buff("840900")
	recharged.energy[2] = 0
	recharged.tick(cost)
	check(is_equal_approx(float(recharged.energy[2]), cost * 2), "unchanged recharge rate takes twice the time to fill awakened skill")
	var blade_source = _combat(8)
	blade_source.add_buff("840900")
	var normal_victim = _combat()
	var awakened_victim = _combat()
	var ordinary_damage = normal_victim.receive({"source": plain, "damage": 10.0, "sequence": 2, "emission": 2, "definition": {"damageId": 2800070, "actType": "SubActiveSkill"}}, plain.attack)
	var empowered_damage = awakened_victim.receive({"source": blade_source, "damage": 10.0, "sequence": 2, "emission": 2, "definition": {"damageId": 2800070, "actType": "SubActiveSkill"}}, blade_source.attack)
	check(is_equal_approx(empowered_damage, ordinary_damage * 2.5), "node 809 source child increases actual combat-skill damage by one hundred fifty percent")
	var overdrive = _combat(8)
	overdrive.add_buff("840500")
	overdrive.add_buff("800500", 3)
	overdrive.tick(1.01)
	check(overdrive.buff_layers("800500") == 2, "ring-blade marker expires one source layer per second instead of clearing the entire stack")
	check(overdrive.buff_layers("840501") == 1, "node 805 full burst-charge and active ring-blade condition applies actual overdrive")
	overdrive.energy[3] = 0
	overdrive.tick(1.0)
	check(overdrive.buff_layers("800500") == 1, "ring-blade marker retains final source layer after the second interval")
	overdrive.tick(0.6)
	check(overdrive.buff_layers("840501") == 0, "node 805 stops refreshing after burst charge is spent")
	overdrive.tick(0.4)
	check(overdrive.buff_layers("800500") == 0, "ring-blade marker clears only after its final source layer expires")
	var blocked_overdrive = _combat(8)
	blocked_overdrive.add_buff("840500")
	blocked_overdrive.add_buff("800500", 3)
	blocked_overdrive.cooldowns[3] = 5
	blocked_overdrive.skill_round_uses[3] = 1
	blocked_overdrive.tick(1.01)
	check(blocked_overdrive.stat_value("SkillActive2CurCanUseTimes") == 0 and blocked_overdrive.buff_layers("840501") == 0, "node 805 does not mistake full charge during a single-use cooldown for an available burst")
	var repeated = _combat(8)
	repeated.set_external_attributes({"SkillActive2ExtraUseCount": 1})
	repeated.energy[3] = repeated.skill_capacity(3)
	check(repeated.stat_value("SkillActive2CurCanUseTimes") == 2 and repeated.request_attack(3).success and repeated.skill_round_uses[3] == 1, "native extra burst capacity starts with two real uses and records first cast")
	repeated.busy = 0
	repeated.custom_properties.erase("_movement_sequence")
	check(repeated.stat_value("SkillActive2CurCanUseTimes") == 1 and repeated.request_attack(3).success and repeated.skill_round_uses[3] == 2, "second stored burst remains usable during the same cooldown round")
	repeated.busy = 0
	repeated.custom_properties.erase("_movement_sequence")
	repeated.energy[3] = repeated.skill_capacity(3)
	check(repeated.stat_value("SkillActive2CurCanUseTimes") == 0 and repeated.request_attack(3).message == "Cooling down", "charge refill cannot exceed the native per-cooldown use limit")
	var saved = repeated.snapshot()
	var resumed = _combat(8)
	check(resumed.restore(saved) and resumed.skill_round_uses[3] == 2 and resumed.skill_available_uses(3) == 0, "combat save preserves the native cooldown-round limit")
	resumed.tick(5.01)
	resumed.busy = 0
	resumed.custom_properties.erase("_movement_sequence")
	check(resumed.skill_available_uses(3) == 2 and resumed.request_attack(3).success and resumed.skill_round_uses[3] == 1, "expired cooldown reopens stored casts and starts a new use round")
	saved.erase("skill_round_uses")
	var legacy = _combat(8)
	check(legacy.restore(saved) and legacy.skill_round_uses[3] == 1, "legacy combat save without round counters remains restorable")
	var mixed = _combat(6)
	mixed.set_external_attributes({"SkillActive1ExtraUseCount": 1.9, "SkillActive1MaxSpAddRate": 500, "SkillActive1CostSpAddRate": 1000})
	check(is_equal_approx(mixed.skill_cost(2), 24) and is_equal_approx(mixed.skill_capacity(2), 42), "native formula truncates extra uses and adds modified cost after independent maximum-charge scaling")
	mixed.energy[2] = 7
	mixed.energy[3] = 61
	check(mixed.stat_value("SkillActive1CurChargeValue") == 7 and mixed.stat_value("SkillActive2CurChargeValue") == 61, "native SkillActive1 and SkillActive2 map to combat skill and burst respectively")
	check(mixed.stat_value("SkillActive1CostSp") == 24 and mixed.stat_value("SkillActive1MaxSp") == 42, "dynamic skill charge attributes read resolved native cost and capacity")
